      "/home/rusich/.config/sops/**": "deny"
    },
    "bash": {
      "*": "allow",
      "*/run/secrets*": "deny",
      "*/run/agenix*": "deny",
      "*/var/lib/sops-nix*": "deny",
      "*/etc/agenix*": "deny",
      "*.config/sops*": "deny"
    }
  },
  "lsp": {
    "nixd": {
      "command": ["nixd"],
      "extensions": [".nix"],
      "initialization": {
        "nixd": {
          "options": {
            "nixos": {
              "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.default.options"
            },
            "home-manager": {
              "expr": "(builtins.getFlake (builtins.toString ./.)).homeConfigurations.default.options"
            }
          }
        }
      }
    }
  }
}
